<section xml:id="sec-cheatsheet">
  <title><pretext /> Cheatsheet</title>

  <p>
    The tags you will reach for most often. Copy, paste, adapt. See
    <url href="https://pretextbook.org">pretextbook.org</url> for the
    official documentation.
  </p>

  <!-- =============================================================== -->
  <!-- Document structure                                              -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-structure">
    <title>Document Structure</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-divisions">
          <title>Divisional levels</title>
          <program language="xml">
            <![CDATA[
              <part>                  <!-- Level 0 -->
                <chapter>             <!-- Level 1 -->
                  <section>           <!-- Level 2 -->
                    <subsection>      <!-- Level 3 -->
                      <subsubsection> <!-- Level 4 -->
                      </subsubsection>
                    </subsection>
                  </section>
                </chapter>
              </part>
            ]]>
          </program>
        </li>

        <li xml:id="block-section-layout">
          <title>A section, front to back</title>
          <program language="xml">
            <![CDATA[
              <section>
                <title>Section Title</title>
                <introduction>...</introduction>

                <subsection>...</subsection>
                <subsection>...</subsection>

                <conclusion>...</conclusion>
                <exercises>...</exercises>
              </section>
            ]]>
          </program>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Paragraphs                                                      -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-paragraphs">
    <title>Paragraphs</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-p">
          <title>Paragraph</title>
          <program language="xml">
            <![CDATA[
              <p>
                Text in a paragraph.
              </p>
            ]]>
          </program>
        </li>

        <li xml:id="block-paragraphs">
          <title>Paragraphs (grouped with title)</title>
          <program language="xml">
            <![CDATA[
              <paragraphs>
                <title>Group Title</title>
                <p>paragraph 1</p>
                <p>paragraph 2</p>
              </paragraphs>
            ]]>
          </program>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Inline formatting                                               -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-inline-formatting">
    <title>Inline Formatting</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-em">
          <title>Emphasis</title>
          <program language="xml">
            <![CDATA[ <em>emphasis</em> ]]>
          </program>
          <p>Renders as: <em>emphasis</em>.</p>
        </li>

        <li xml:id="block-term">
          <title>New term</title>
          <program language="xml">
            <![CDATA[ <term>new term</term> ]]>
          </program>
          <p>Renders as: <term>new term</term> (bold). Use when introducing vocabulary for the first time.</p>
        </li>

        <li xml:id="block-c">
          <title>Inline code</title>
          <program language="xml">
            <![CDATA[ <c>inline code</c> ]]>
          </program>
          <p>Renders as: <c>inline code</c>. Use for filenames, code, etc.</p>
        </li>

        <li xml:id="block-alert">
          <title>Alert</title>
          <program language="xml">
            <![CDATA[ <alert>attention</alert> ]]>
          </program>
          <p>Renders as: <alert>attention</alert> (bold italic). Use sparingly for genuine emphasis.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Lists                                                           -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-lists">
    <title>Lists</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-ul">
          <title>Unordered list</title>
          <program language="xml">
            <![CDATA[
              <ul>
                <li><p>item</p></li>
                <li><p>item</p></li>
              </ul>
            ]]>
          </program>
          <p>The <tag>p</tag> tags inside <tag>li</tag> are optional when the item is a single paragraph.</p>
        </li>

        <li xml:id="block-ol">
          <title>Ordered list</title>
          <program language="xml">
            <![CDATA[
              <ol>
                <li>item</li>
                <li>item</li>
                <li>item</li>
              </ol>
            ]]>
          </program>
          <p>Add <c>cols="2"</c> or <c>cols="3"</c> on the <tag>ol</tag> to lay items out in columns.</p>
        </li>

        <li xml:id="block-dl">
          <title>Description list</title>
          <program language="xml">
            <![CDATA[
              <dl>
                <li>
                  <title>Term</title>
                  <p>Description.</p>
                </li>
                <li>
                  <title>Term</title>
                  <p>Description.</p>
                </li>
              </dl>
            ]]>
          </program>
          <p>Optional attribute: <c>width="narrow|medium|wide"</c> to adjust title vs. description width.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Math                                                            -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-math">
    <title>Math</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-m">
          <title>Inline</title>
          <program language="xml">
            <![CDATA[ <m>x^2 + 1</m> ]]>
          </program>
        </li>

        <li xml:id="block-me-md">
          <title>Display, single-line</title>
          <program language="xml">
            <![CDATA[
              <md>\sum_{i=1}^n x_i^2</md>
            ]]>
          </program>
        </li>

        <!-- <li xml:id="block-men">
          <title>Numbered display equation</title>
          <program language="xml">
            <![CDATA[ <men>e^{i\pi} + 1 = 0</men> ]]>
          </program>
          <p>Give the equation an <c>xml:id</c> to reference it with <tag>xref</tag>.</p>
        </li> -->

        <li xml:id="block-md-aligned">
          <title>Aligned, multi-line</title>
          <program language="xml">
            <![CDATA[
              <md>
                <mrow>a^2 + b^2 \amp = c^2</mrow>
                <mrow>y \amp = mx + b</mrow>
                <mrow>m \amp = \frac{y-b}{x}</mrow>
                <mrow>  \amp = \frac{14}{3}</mrow>
              </md>
            ]]>
          </program>
          <p>The <c>\amp</c> character is the alignment anchor (<c>&amp;</c> in <latex/>).</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Teaching blocks                                                 -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-blocks">
    <title>Definitions, Theorems, Examples</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-definition">
          <title>Definition</title>
          <program language="xml">
            <![CDATA[
              <definition xml:id="def-x">
                <statement>...</statement>
              </definition>
            ]]>
          </program>
          <p>The <c>xml:id</c> is optional, but add one if you want to cross-reference the definition later with <tag>xref</tag>.</p>
        </li>

        <li xml:id="block-theorem">
          <title>Theorem with proof</title>
          <program language="xml">
            <![CDATA[
              <theorem>
                <statement>...</statement>
                <proof>...</proof>
              </theorem>
            ]]>
          </program>
        </li>

        <li xml:id="block-example">
          <title>Example</title>
          <program language="xml">
            <![CDATA[
              <example xml:id="ex-x">
                <title>...</title>
                <statement>...</statement>
                <solution>...</solution>
              </example>
            ]]>
          </program>
          <p>The <tag>solution</tag> is optional. If you include it, it renders as a knowl the reader can expand.</p>
        </li>

        <li xml:id="block-remark">
          <title>Remark</title>
          <program language="xml">
            <![CDATA[
              <remark>
                <p>A note.</p>
              </remark>
            ]]>
          </program>
        </li>

        <li xml:id="block-aside">
          <title>Aside</title>
          <program language="xml">
            <![CDATA[
              <aside>
                <p>A short aside.</p>
              </aside>
            ]]>
          </program>
          <p>An <tag>aside</tag> renders in the margin (on wide screens) or inline (on narrow ones), visually distinct from a <tag>remark</tag>.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Exercises                                                       -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-exercises">
    <title>Exercises</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-exercise">
          <title>Simple exercise</title>
          <program language="xml">
            <![CDATA[
              <exercise>
                <statement>...</statement>
              </exercise>
            ]]>
          </program>
        </li>

        <li xml:id="block-exercise-tasks">
          <title>Exercise with tasks</title>
          <program language="xml">
            <![CDATA[
              <exercise xml:id="exr-x">
                <introduction>...</introduction>
                <task>
                  <statement>...</statement>
                  <answer>...</answer>
                </task>
                <task>
                  <statement>...</statement>
                  <answer>...</answer>
                </task>
              </exercise>
            ]]>
          </program>
          <p>Use <tag>task</tag> for multi-part exercises. Each part gets its own answer knowl.</p>
        </li>

        <li xml:id="block-exercise-has">
          <title>Hint, answer, solution</title>
          <program language="xml">
            <![CDATA[
              <exercise xml:id="exr-y">
                <statement>...</statement>
                <hint>...</hint>
                <answer>...</answer>
                <solution>...</solution>
              </exercise>
            ]]>
          </program>
          <p>All three are optional. Order matters: <tag>statement</tag> first, then any combination of <tag>hint</tag>, <tag>answer</tag>, <tag>solution</tag>.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Worksheets                                                      -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-worksheets">
    <title>Worksheets</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-worksheet">
          <title>Worksheet</title>
          <program language="xml">
            <![CDATA[
              <worksheet xml:id="ws-x">
                <title>...</title>
                <objectives>...</objectives>

                <page>...</page>
                <page>...</page>
              </worksheet>
            ]]>
          </program>
          <p>
            A <tag>worksheet</tag> is a special environment that behaves like a <tag>section</tag>, but is styled differently and supports printing. <tag>worksheet</tag> can be split across <tag>page</tag> elements to help control the layout.
          </p>
          <p>
            While <tag>title</tag>, <tag>objectives</tag>, and <tag>page</tag> elements are common child elements of worksheets, they are optional.
          </p>
        </li>

        <li xml:id="block-objectives">
          <title>Objectives</title>
          <program language="xml">
            <![CDATA[
              <objectives>
                <ul>
                  <li>...</li>
                  <li>...</li>
                  <li>...</li>
                </ul>
              </objectives>
            ]]>
          </program>
          <p>Place at the top of a worksheet or chapter.</p>
        </li>

        <li xml:id="block-workspace">
          <title>Exercise with workspace</title>
          <program language="xml">
            <![CDATA[
              <exercise workspace="2.5in">
                <statement>...</statement>
              </exercise>
            ]]>
          </program>
          <p>Add <c>workspace="2.5in"</c> to an exercise inside a worksheet to leave blank space for student work when the worksheet is printed. Adjust the measurement to suit the problem.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Interactive questions                                           -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-interactive">
    <title>Interactive Questions</title>

    <p>
      <dl width="narrow">

        <li xml:id="block-tf">
          <title>True / False</title>
          <program language="xml">
            <![CDATA[
              <exercise xml:id="ex-tf">
                <title> Exercise Title </title>
                <statement correct="no">
                  <p> A statement that might be true or false. </p>
                </statement>
                <feedback>
                  <p> Why the statement is true or false. </p>
                </feedback>
              </exercise>
            ]]>
          </program>
          <p>The true and false indicators are <c>correct="yes"</c> and <c>correct="no"</c>, respectively goes directly inside the <tag>statement</tag> tag. </p>
        </li>

        <li xml:id="block-mc">
          <title>Multiple-Choice &amp; Multiple-Answer</title>
          <program language="xml">
            <![CDATA[
              <exercise xml:id="ex-mc">
                <title> Exercise Title </title>
                <statement> Problem Statement </statement>
                <choices randomize="yes">
                  <choice>
                    <statement> Distractor. </statement>
                    <feedback> Why this is wrong. </feedback>
                  </choice>
                  <choice correct="yes">
                    <statement> Correct answer. </statement>
                    <feedback> Why this is right. </feedback>
                  </choice>
                  <choice>
                    <statement> Distractor. </statement>
                    <feedback> Why this is wrong. </feedback>
                  </choice>
                </choices>
              </exercise>
            ]]>
          </program>
          <p>When exactly one <tag>choice</tag> has <c>correct="yes"</c>, it is a multiple-choice question. When more than one <tag>choice</tag> has <c>correct="yes"</c>, it is a multiple-answer question. Optional <c>randomize="yes"</c> on <tag>choices</tag> shuffles the order.</p>
        </li>

        <li xml:id="block-cardsort">
          <title>Cardsort-Matching</title>
          <program language="xml">
            <![CDATA[
              <exercise label="chkpt-matching">
                <title> Exercise Title </title>
                <statement> Problem Statement </statement>
                <feedback> General Feedback </feedback>
                <cardsort>
                  <match>
                    <premise> Item 1 </premise>
                    <response> Target 1 </response>
                  </match>
                  <match>
                    <premise> Item 2 </premise>
                    <response> Target 2 </response>
                  </match>
                  <match>
                    <premise> Item 3a </premise>
                    <premise> Item 3b </premise>
                    <premise> Item 3c </premise>
                    <response> Target 3 </response>
                  </match>
                  <match>
                    <premise> Distractor Item </premise>
                  </match>
                  <match>
                    <response> Distractor Target </response>
                  </match>
                </cardsort>
              </exercise>
            ]]>
          </program>
          <p></p>
        </li>

        <li xml:id="block-clickable-area">
          <title>Clickable Area</title>
          <program language="xml">
            <![CDATA[
              <exercise label="chkpt-fill-in-the-blank">
                <title> Exercise Title </title>
                <statement> Problem Statement </statement>
                <areas>
                  <p>
                    Non-Clickable Text *
                    <area> Correct Clickable Item 1 </area> *
                    <area> Correct Clickable Item 2 </area> *
                    <area correct="no"> Incorrect Clickable </area> *
                    <area> Correct Clickable Item 3 </area> *
                    <area correct="no"> Incorrect Clickable </area> *
                  </p>
                </areas>
                <feedback> General Feedback </feedback>
              </exercise>
            ]]>
          </program>
          <p></p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Links, xrefs                                                    -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-links">
    <title>Links &amp; Cross-references</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-url">
          <title>External link</title>
          <program language="xml">
            <![CDATA[
              <url href="https://abc.com">
                click here
              </url>
            ]]>
          </program>
        </li>

        <li xml:id="block-xref">
          <title>Internal cross-reference</title>
          <program language="xml">
            <![CDATA[
              <xref ref="def-x"/>
              <xref ref="def-x" text="title"/>
              <xref ref="def-x" text="custom">see here</xref>
            ]]>
          </program>
          <p>The target must have an <c>xml:id</c>. Default link text is auto-generated (e.g., <q>Definition 3.1</q>); <c>text="title"</c> uses the target's title; <c>text="custom"</c> lets you write your own link text between the opening and closing tags.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Figures                                                         -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-figures">
    <title>Figures</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-figure">
          <title>Figure with image</title>
          <program language="xml">
            <![CDATA[
              <figure xml:id="fig-x">
                <caption>My caption.</caption>
                <image source="path.png">
                  <shortdescription>
                    Brief alt text.
                  </shortdescription>
                </image>
              </figure>
            ]]>
          </program>
          <p>Every image needs a <tag>shortdescription</tag> for screen readers. Keep it brief and literal. Describe what the image shows, not what it means.</p>
        </li>
      </dl>
    </p>
  </assemblage>

  <!-- =============================================================== -->
  <!-- Tables                                                          -->
  <!-- =============================================================== -->
  <assemblage xml:id="cheatsheet-tables">
    <title>Tables</title>

    <p>
      <dl width="narrow">
        <li xml:id="block-tabular">
          <title>Minimal table</title>
          <program language="xml">
            <![CDATA[
              <tabular>
                <row>
                  <cell>A</cell>
                  <cell>B</cell>
                </row>
                <row>
                  <cell>C</cell>
                  <cell>D</cell>
                </row>
              </tabular>
            ]]>
          </program>
        </li>

        <li xml:id="block-tabular-header">
          <title>Table with a header row</title>
          <program language="xml">
            <![CDATA[
              <tabular>
                <row header="yes">
                  <cell>Name</cell>
                  <cell>Value</cell>
                </row>
                <row>
                  <cell>...</cell>
                  <cell>...</cell>
                </row>
              </tabular>
            ]]>
          </program>
        </li>

        <li xml:id="block-tabular-styled">
          <title>Table with borders and column widths</title>
          <program language="xml">
            <![CDATA[
              <tabular top="minor" bottom="minor"
                       left="minor" right="minor">
                <col width="30%" halign="center"/>
                <col width="70%"/>
                <row header="yes">
                  <cell>Name</cell>
                  <cell>Description</cell>
                </row>
                <row>
                  <cell>...</cell>
                  <cell>...</cell>
                </row>
              </tabular>
            ]]>
          </program>
          <p>Border options: <c>none</c>, <c>minor</c>, <c>medium</c>, <c>major</c>. Alignment options: <c>left</c>, <c>center</c>, <c>right</c>.</p>
        </li>
      </dl>
    </p>
  </assemblage>

</section>
