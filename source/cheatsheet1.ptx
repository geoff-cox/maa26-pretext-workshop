<section xml:id="sec-cheatsheet">
  <title><pretext /> Cheatsheet</title>

  <introduction>
    <p>
      The tags you will reach for most often. Copy, paste, adapt. Replace placeholders like
      <c>T</c>, <c>def-x</c>, and <c>path.png</c> with your own content. For fuller documentation,
      see <url href="https://pretextbook.org">pretextbook.org</url>.
    </p>
  </introduction>

  <!-- =============================================================== -->
  <!-- Document structure                                              -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-structure">
    <title>Document Structure</title>

    <sbsgroup widths="48% 48%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Divisional levels</term></p>
          <program language="xml">
            &lt;part&gt;                  &lt;!-- 0 --&gt;
              &lt;chapter&gt;             &lt;!-- 1 --&gt;
                &lt;section&gt;           &lt;!-- 2 --&gt;
                  &lt;subsection&gt;      &lt;!-- 3 --&gt;
                    &lt;subsubsection&gt; &lt;!-- 4 --&gt;
                    &lt;/subsubsection&gt;
                  &lt;/subsection&gt;
                &lt;/section&gt;
              &lt;/chapter&gt;
            &lt;/part&gt;
          </program>
        </stack>
        <stack>
          <p><term>A section, front to back</term></p>
          <program language="xml">
            &lt;section&gt;
              &lt;title&gt;Section Title&lt;/title&gt;
              &lt;introduction&gt;...&lt;/introduction&gt;

              &lt;subsection&gt;...&lt;/subsection&gt;
              &lt;subsection&gt;...&lt;/subsection&gt;

              &lt;conclusion&gt;...&lt;/conclusion&gt;
              &lt;exercises&gt;...&lt;/exercises&gt;
            &lt;/section&gt;
          </program>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Text, inline formatting                                         -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-text">
    <title>Text and Inline Formatting</title>

    <sbsgroup widths="48% 48%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Paragraph</term></p>
          <program language="xml">
            &lt;p&gt;
              Most prose lives inside a 
              paragraph.
            &lt;/p&gt;
          </program>
        </stack>
        <stack>
          <p><term>Inline formatting</term></p>
          <program language="xml">
            &lt;em&gt;emphasis&lt;/em&gt;
            &lt;term&gt;new term (bold)&lt;/term&gt;
            &lt;c&gt;inline code&lt;/c&gt;
            &lt;q&gt;quoted text&lt;/q&gt;
          </program>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Lists                                                           -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-lists">
    <title>Lists</title>

    <sbsgroup widths="48% 48%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Bulleted &amp; numbered</term></p>
          <program language="xml">
            &lt;ul&gt;
              &lt;li&gt;&lt;p&gt;item&lt;/p&gt;&lt;/li&gt;
              &lt;li&gt;&lt;p&gt;item&lt;/p&gt;&lt;/li&gt;
            &lt;/ul&gt;

            &lt;ol&gt;
              &lt;li&gt;&lt;p&gt;item&lt;/p&gt;&lt;/li&gt;
              &lt;li&gt;&lt;p&gt;item&lt;/p&gt;&lt;/li&gt;
              &lt;li&gt;&lt;p&gt;item&lt;/p&gt;&lt;/li&gt;
            &lt;/ol&gt;
          </program>
        </stack>
        <stack>
          <p><term>Description list</term></p>
          <program language="xml">
            &lt;dl&gt;
              &lt;li&gt;
                &lt;title&gt;Term&lt;/title&gt;
                &lt;p&gt;Description.&lt;/p&gt;
              &lt;/li&gt;
              &lt;li&gt;
                &lt;title&gt;Term&lt;/title&gt;
                &lt;p&gt;Description.&lt;/p&gt;
              &lt;/li&gt;
            &lt;/dl&gt;
          </program>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Math                                                            -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-math">
    <title>Math</title>

    <sbsgroup widths="41% 55%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Inline and display</term></p>
          <program language="xml">
            Inline: &lt;m&gt;x^2 + 1&lt;/m&gt;

            Display:
            &lt;me&gt;\int_0^1 f(x) dx&lt;/me&gt;
            &lt;md&gt;\sum_{i=1}^n x_i^2&lt;/md&gt;

            Numbered display:
            &lt;men&gt;e^{i\pi} + 1 = 0&lt;/men&gt;
          </program>
        </stack>
        <stack>
          <p><term>Aligned, multi-line</term></p>
          <program language="xml">
            &lt;md&gt;
              &lt;mrow&gt;a^2 + b^2 \amp = c^2&lt;/mrow&gt;
              &lt;mrow&gt;y \amp = mx + b&lt;/mrow&gt;
              &lt;mrow&gt;m \amp = \frac{y - b}{x}&lt;/mrow&gt;
              &lt;mrow&gt;  \amp = \frac{14}{3}&lt;/mrow&gt;
            &lt;/md&gt;
          </program>
          <p>Note: <pf>\amp</pf> is the alignment anchor</p>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Teaching blocks                                                 -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-blocks">
    <title>Definitions, Theorems, Examples</title>

    <sbsgroup widths="44% 52%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Definition</term></p>
          <program language="xml">
&lt;definition xml:id="def-x"&gt;
  &lt;statement&gt;
    &lt;p&gt;...&lt;/p&gt;
  &lt;/statement&gt;
&lt;/definition&gt;
          </program>
        </stack>
        <stack>
          <p><term>Theorem with proof</term></p>
          <program language="xml">
&lt;theorem xml:id="thm-x"&gt;
  &lt;statement&gt;&lt;p&gt;...&lt;/p&gt;&lt;/statement&gt;
  &lt;proof&gt;&lt;p&gt;...&lt;/p&gt;&lt;/proof&gt;
&lt;/theorem&gt;
          </program>
        </stack>
      </sidebyside>

      <sidebyside valign="top">
        <stack>
          <p><term>Remark</term></p>
          <program language="xml">
            &lt;remark&gt;
              &lt;p&gt;A note.&lt;/p&gt;
            &lt;/remark&gt;
          </program>
          <p><term>Aside</term></p>
          <program language="xml">
            &lt;aside&gt;
              &lt;p&gt;A short aside.&lt;/p&gt;
            &lt;/aside&gt;
          </program>
        </stack>
        <stack>
          <p><term>Example</term></p>
          <program language="xml">
            &lt;example xml:id="ex-x"&gt;
              &lt;title&gt;T&lt;/title&gt;
              &lt;statement&gt;
                &lt;p&gt;...&lt;/p&gt;
              &lt;/statement&gt;
              &lt;solution&gt;&lt;
                p&gt;...&lt;/p&gt;
              &lt;/solution&gt;
            &lt;/example&gt;
          </program>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Exercises                                                       -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-exercises">
    <title>Exercises</title>

    <sbsgroup widths="48% 48%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Simple exercise</term></p>
          <program language="xml">
            &lt;exercise xml:id="exr-x"&gt;
              &lt;statement&gt;
                &lt;p&gt;...&lt;/p&gt;
              &lt;/statement&gt;
            &lt;/exercise&gt;
          </program>
          <p><term>Exercise with tasks</term></p>
          <program language="xml">
            &lt;exercise xml:id="exr-x"&gt;
              &lt;introduction&gt;...&lt;/introduction&gt;
              &lt;task&gt;...
                &lt;statement&gt;...&lt;/statement&gt;
              &lt;/task&gt;
              &lt;task&gt;
                &lt;statement&gt;...&lt;/statement&gt;
              &lt;/task&gt;
            &lt;/exercise&gt;
          </program>
        </stack>
        <stack>
          <p><term>With hint, answer, solution</term></p>
          <program language="xml">
            &lt;exercise xml:id="exr-y"&gt;
              &lt;statement&gt;
                &lt;p&gt;...&lt;/p&gt;
              &lt;/statement&gt;
              &lt;hint&gt;
                &lt;p&gt;...&lt;/p&gt;
              &lt;/hint&gt;
              &lt;answer&gt;
                &lt;p&gt;...&lt;/p&gt;
              &lt;/answer&gt;
              &lt;solution&gt;
                &lt;p&gt;...&lt;/p&gt;
              &lt;/solution&gt;
            &lt;/exercise&gt;
          </program>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Links, xrefs, figures                                           -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-links-media">
    <title>Links, Cross-references, and Figures</title>

    <sbsgroup widths="48% 48%" margins="1% 1%">
      <sidebyside valign="top">
        <stack>
          <p><term>Links and cross-references</term></p>
          <p>External:</p>
          <program language="xml">
            &lt;url href="https://example.com"&gt;
              click here
            &lt;/url&gt;
          </program>
          <p>Internal (via <pf>xml:id</pf>):</p>
          <program language="xml">
            See &lt;xref ref="def-x"/&gt;.
          </program>
        </stack>
        <stack>
          <p><term>Figure with caption</term></p>
          <program language="xml">
            &lt;figure xml:id="fig-x"&gt;
              &lt;caption&gt;My caption.&lt;/caption&gt;

              &lt;image source="path.png"&gt;
                &lt;shortdescription&gt;
                  Brief alt text.
                &lt;/shortdescription&gt;
              &lt;/image&gt;
            &lt;/figure&gt;
          </program>
        </stack>
      </sidebyside>
    </sbsgroup>
  </subsection>

  <!-- =============================================================== -->
  <!-- Gotchas                                                         -->
  <!-- =============================================================== -->
  <subsection xml:id="cheatsheet-gotchas">
    <title>Four Things That Trip Everyone Up</title>
    <p>
      <ul>
        <li><p>List items need a <c>&lt;p&gt;</c> inside: <c>&lt;li&gt;&lt;p&gt;text&lt;/p&gt;&lt;/li&gt;</c>.</p></li>
        <li><p>Every open tag needs a close tag. Mismatched tags are the <em>most common</em> build error.</p></li>
        <li><p>Use <c>xml:id</c> (not <c>id</c>) for anything an <c>&lt;xref/&gt;</c> will point to.</p></li>
        <li><p>Save <em>and</em> rebuild after edits — the preview does not refresh on its own.</p></li>
      </ul>
    </p>
  </subsection>

</section>
